# Blocky402 testnet facilitator
FACILITATOR_URL=https://api.testnet.blocky402.com

# Resource server (seller) — Hedera testnet account that receives payment
SELLER_ACCOUNT_ID=0.0.xxxxx
PORT=4021

# Consuming client (buyer) — Hedera testnet account that pays
BUYER_ACCOUNT_ID=0.0.xxxxx
BUYER_PRIVATE_KEY=302e...   # ECDSA private key (hex or DER, PrivateKey.fromString handles both)

# Price for the gated resource, in tinybars (1 HBAR = 100_000_000 tinybars)
# Default below is 0.05 HBAR.
PRICE_TINYBARS=5000000

RESOURCE_SERVER_URL=http://localhost:4021

# Powers the "researcher" agent's two real paid deliverables
# (POST /paid/research/term-paper, POST /paid/research/news). Without this,
# the server starts fine but those two routes are not mounted at all — see
# README "Landing page, dashboard, and four agents".
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional per-route price overrides, in tinybars. Defaults: 0.05 HBAR for
# term-paper feedback, 0.03 HBAR for news analysis.
# RESEARCH_TERM_PAPER_PRICE_TINYBARS=5000000
# RESEARCH_NEWS_PRICE_TINYBARS=3000000

# Optional: dedicated burner account per requester agent, so each of the 3
# pays from its own identity instead of sharing BUYER_ACCOUNT_ID above. Each
# requester falls back to BUYER_ACCOUNT_ID/BUYER_PRIVATE_KEY until its own
# pair here is filled in — see README "Landing page, dashboard, and four agents".
REQUESTER_1_ACCOUNT_ID=
REQUESTER_1_PRIVATE_KEY=
REQUESTER_2_ACCOUNT_ID=
REQUESTER_2_PRIVATE_KEY=
REQUESTER_3_ACCOUNT_ID=
REQUESTER_3_PRIVATE_KEY=
